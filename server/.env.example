# 服务器配置
PORT=3000
NODE_ENV=development

# 客户端地址（CORS 允许的来源）
CLIENT_ORIGIN=https://linglan.xin

# JWT 密钥（运行 `python -c "import secrets; print(secrets.token_hex(32))"` 生成）
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# 管理员账号（首次启动时自动创建）
ADMIN_EMAIL=admin@linglan.xin
ADMIN_PASSWORD=your-admin-password-here
ADMIN_USERNAME=admin

# QQ 邮箱 SMTP 配置（发送验证邮件/密码重置邮件）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-qq-email@qq.com
SMTP_PASS=your-qq-smtp-authorization-code
SMTP_FROM="Vers123 游戏导航 <your-qq-email@qq.com>"

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=https://linglan.xin/api/auth/oauth/github/callback

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://linglan.xin/api/auth/oauth/google/callback

# 数据库路径
DB_PATH=./data/game-nav.db
